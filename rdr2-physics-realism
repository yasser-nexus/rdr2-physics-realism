            float warmth = 0f;
            for (int i = 0; i < _sites.Count; i++)
            {
                CampSite s = _sites[i];
                if (!s.Lit || s.Fire == null || !s.Fire.Exists()) continue;
                float d = _ctx.Pos.DistanceTo(s.Position);
                if (d < s.HeatRadius) warmth = Math.Max(warmth, (1f - d / s.HeatRadius) * (s.Fuel / 100f));
            }
            if (warmth <= 0f) return;
            PhysiologyState st = _phys.State;
            st.ColdExposure = Mathx.Clamp(st.ColdExposure - warmth * 0.35f * dt, 0f, 1.5f);
            if (st.CoreTempC < 37.1f) st.CoreTempC += warmth * 0.12f * dt;
            st.Wetness = Mathx.Clamp(st.Wetness - warmth * 0.08f * dt, 0f, 1f);
            if (_ctx.Speed < 0.35f)
            {
                st.MuscleFatigue = Mathx.Clamp(st.MuscleFatigue - warmth * 4.5f * dt, 0f, 100f);
                st.Stamina = Mathx.Clamp(st.Stamina + warmth * 6f * dt, 0f, 100f);
            }
        }
        private CampSite Nearest(float max)
        {
            CampSite best = null; float bd = max;
