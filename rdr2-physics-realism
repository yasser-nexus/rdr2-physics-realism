            Vector3[] dirs = { new Vector3(radius, 0f, 0.3f), new Vector3(-radius, 0f, 0.3f), new Vector3(0f, radius, 0.3f), new Vector3(0f, -radius, 0.3f), new Vector3(radius * 0.7f, radius * 0.7f, 0.3f), new Vector3(0f, 0f, 2.2f) };
            for (int i = 0; i < dirs.Length; i++)
            {
                Vector3 hit; int ent;
                if (!NativeBridge.ClearLos(from, from + dirs[i], 1 | 16 | 256, ignore, out hit, out ent))
