    public enum StimulusKind { None, Gunshot, Voice, Footstep, CampSmoke, CampLight, Visual }
    public struct Stimulus { public StimulusKind Kind; public Vector3 Position; public float Time; public float Intensity; public int Source; }
    public struct Footprint { public Vector3 Position; public float Heading; public float Time; public float Wetness; public bool Sprint; }

    public sealed class PerceptionEngine
    {
        private sealed class Aware { public float Alert; public Vector3 Last; public bool Has; public float Until; }
        private readonly GameContext _ctx;
        private readonly CampingEngine _camp;
        private readonly List<Footprint> _prints = new List<Footprint>(256);
        private readonly Stimulus[] _ring = new Stimulus[64];
        private readonly Stimulus[] _scratch = new Stimulus[64];
        private readonly Dictionary<int, Aware> _aware = new Dictionary<int, Aware>(64);
        private readonly Dictionary<int, int> _acc = new Dictionary<int, int>();
        private readonly HashSet<int> _touch = new HashSet<int>();
        private int _w; private float _time, _accum; private bool _wasShot; private Vector3 _lastPrint; private bool _hasPrint;
        public PerceptionEngine(GameContext ctx, CampingEngine camp) { _ctx = ctx; _camp = camp; }
        public void Update(float dt)
        {
            if (!_ctx.Valid) return;
            _time += dt; _accum += dt;
            Trail();
            if (_ctx.Shooting && !_wasShot) Push(StimulusKind.Gunshot, _ctx.Pos, _ctx.Night ? 1f : 0.75f, _ctx.Player.Handle);
            _wasShot = _ctx.Shooting;
            IReadOnlyList<CampSite> sites = _camp.Sites;
            for (int i = 0; i < sites.Count; i++)
            {
                CampSite s = sites[i];
                if (s == null || !s.Lit) continue;
                int src = s.Fire != null ? s.Fire.Handle : 0;
                if (s.SmokeVisible) Push(StimulusKind.CampSmoke, s.Position, s.Fuel / 100f, src);
                if (_ctx.Night) Push(StimulusKind.CampLight, s.Position, 0.8f * s.Fuel / 100f, src);
            }
            if (_accum < _ctx.Cfg.TickPerception) return;
            _accum = 0f; Scan();
        }
        private void Trail()
        {
            if (_ctx.OnMount || _ctx.Speed < 0.35f) return;
            if (!_hasPrint) { AddPrint(_ctx.Pos); _hasPrint = true; _lastPrint = _ctx.Pos; return; }
            if (_ctx.Pos.DistanceTo(_lastPrint) >= _ctx.Cfg.FootstepSpacingMeters) { AddPrint(_ctx.Pos); _lastPrint = _ctx.Pos; }
            int w = 0;
            for (int i = 0; i < _prints.Count; i++)
                if (_time - _prints[i].Time <= _ctx.Cfg.FootstepTrailLifetimeSeconds) { if (w != i) _prints[w] = _prints[i]; w++; }
            if (w < _prints.Count) _prints.RemoveRange(w, _prints.Count - w);
        }
        private void AddPrint(Vector3 p)
        {
            _prints.Add(new Footprint { Position = p, Heading = _ctx.Player.Heading, Time = _time, Wetness = _ctx.Rain + (_ctx.InWater ? 1f : 0f), Sprint = _ctx.Sprinting });
            if (_prints.Count > 400) _prints.RemoveRange(0, _prints.Count - 320);
        }
        private void Push(StimulusKind k, Vector3 p, float i, int src)
        {
            _ring[_w] = new Stimulus { Kind = k, Position = p, Time = _time, Intensity = i, Source = src };
            _w = (_w + 1) % _ring.Length;
        }
        private int CopyRecent(float age)
        {
            int n = 0;
            for (int i = 0; i < _ring.Length && n < _scratch.Length; i++)
                if (_ring[i].Kind != StimulusKind.None && _time - _ring[i].Time <= age) _scratch[n++] = _ring[i];
            return n;
        }
        private bool NearPrint(Vector3 h, float r, float maxAge, out Footprint fp)
        {
            fp = default(Footprint); float best = r; bool ok = false;
            for (int i = _prints.Count - 1; i >= 0; i--)
            {
                if (_time - _prints[i].Time > maxAge) continue;
                float d = h.DistanceTo(_prints[i].Position);
                if (d < best) { best = d; fp = _prints[i]; ok = true; }
            }
            return ok;
        }
        private void Scan()
        {
            Ped player = _ctx.Player; Ped[] nearby;
            try { nearby = World.GetNearbyPeds(player, Math.Max(_ctx.Cfg.LosMaxMeters, _ctx.Cfg.GunshotHearNightMeters)); }
            catch (Exception ex) { _ctx.Log.Error("Perception", "Peds", ex); return; }
            if (nearby == null) return;
            _touch.Clear();
            int nStim = CopyRecent(12f); int scanned = 0;
            foreach (Ped ped in nearby)
            {
                if (scanned++ >= _ctx.Cfg.PerceptionPedScanCap) break;
                if (!NativeBridge.PedOk(ped) || ped.Handle == player.Handle || ped.IsPlayer) continue;
                _touch.Add(ped.Handle);
                Aware a;
                if (!_aware.TryGetValue(ped.Handle, out a)) { a = new Aware(); _aware[ped.Handle] = a; Strip(ped); }
                float see = Vision(ped, player);
                float hear = Hear(ped, nStim);
                float track = Track(ped);
                float stim = Math.Max(see, Math.Max(hear, track));
                if (stim < 0.05f) a.Alert = Math.Max(0f, a.Alert - 0.18f * _ctx.Cfg.TickPerception);
                else a.Alert = Mathx.Saturate(a.Alert + stim * 1.8f * _ctx.Cfg.TickPerception);
                if (see > 0.55f) { a.Last = player.Position; a.Has = true; }
                else if (track > 0.45f)
                {
                    Footprint fp;
                    if (NearPrint(ped.Position, 3.2f, _ctx.Cfg.FootstepTrailLifetimeSeconds, out fp)) { a.Last = fp.Position; a.Has = true; }
                }
                Apply(ped, a, see);
            }
            if (_aware.Count == 0) return;
            List<int> drop = null;
            foreach (KeyValuePair<int, Aware> kv in _aware)
                if (!_touch.Contains(kv.Key)) { if (drop == null) drop = new List<int>(); drop.Add(kv.Key); }
            if (drop == null) return;
            for (int i = 0; i < drop.Count; i++) { _aware.Remove(drop[i]); _acc.Remove(drop[i]); }
        }
        private void Strip(Ped ped)
        {
            try
            {
                Function.Call(Hash.SET_PED_SEEING_RANGE, ped.Handle, 0.01f);
                Function.Call(Hash.SET_PED_HEARING_RANGE, ped.Handle, 0.01f);
                Function.Call(Hash.SET_PED_ID_RANGE, ped.Handle, 0.01f);
                Function.Call(Hash.SET_PED_VISUAL_FIELD_MIN_ANGLE, ped.Handle, 0.01f);
                Function.Call(Hash.SET_PED_VISUAL_FIELD_MAX_ANGLE, ped.Handle, 0.01f);
                Function.Call(Hash.SET_PED_VISUAL_FIELD_PERIPHERAL_RANGE, ped.Handle, 0.01f);
            }
            catch (Exception ex) { _ctx.Log.Error("Perception", "Strip", ex); }
        }
        private float Vision(Ped hunter, Ped player)
        {
            Vector3 eye = hunter.Position + new Vector3(0f, 0f, 0.72f);
            Vector3 tgt = player.Position + new Vector3(0f, 0f, 0.65f);
            float dist = eye.DistanceTo(tgt);
            if (dist > _ctx.Cfg.LosMaxMeters) return 0f;
            Vector3 to = Mathx.SafeNormalize(Mathx.Horizontal(tgt - eye));
            Vector3 fwd = Mathx.SafeNormalize(Mathx.Horizontal(NativeBridge.Forward(hunter)));
            float losDot = Mathx.Dot(fwd, to);
            float fov = _ctx.Night ? 0.55f : 0.42f;
            if (losDot < fov) return 0f;
            Vector3 hit; int ent;
            bool clear = NativeBridge.ClearLos(eye, tgt, 1 | 16 | 256, hunter.Handle, out hit, out ent);
            if (!clear && ent != player.Handle) return 0f;
            float light = _ctx.Night ? 0.28f : 1f;
            if (_ctx.Night)
            {
                IReadOnlyList<CampSite> sites = _camp.Sites;
                for (int i = 0; i < sites.Count; i++)
                    if (sites[i].Lit && player.Position.DistanceTo(sites[i].Position) < 6f) light = Math.Max(light, 0.75f);
            }
            float stealth = (_ctx.Stealth ? 0.45f : 1f) * (_ctx.Speed < 0.2f ? 0.7f : 1f);
