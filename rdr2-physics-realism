        private float Hear(Ped hunter, int n)
        {
            float best = 0f;
            float gun = _ctx.Night ? _ctx.Cfg.GunshotHearNightMeters : _ctx.Cfg.GunshotHearDayMeters;
            for (int i = 0; i < n; i++)
            {
                Stimulus s = _scratch[i];
                float range = 0f;
                if (s.Kind == StimulusKind.Gunshot) range = gun;
                else if (s.Kind == StimulusKind.Voice) range = _ctx.Cfg.VoiceHearMeters;
                if (range <= 0f) continue;
                float d = hunter.Position.DistanceTo(s.Position);
                if (d < range) best = Math.Max(best, (1f - d / range) * s.Intensity);
            }
            if (_ctx.Shooting)
            {
                float d = hunter.Position.DistanceTo(_ctx.Pos);
                if (d < gun) best = Math.Max(best, 1f - d / gun);
            }
            return Mathx.Saturate(best);
        }
        private float Track(Ped hunter)
        {
            Footprint fp;
            float ageMax = _ctx.Cfg.FootstepTrailLifetimeSeconds * (_ctx.Rain > 0.4f ? 0.45f : 1f);
            if (!NearPrint(hunter.Position, 2.6f, ageMax, out fp)) return 0f;
            float vis = 0.35f + fp.Wetness * 0.4f + (fp.Sprint ? 0.2f : 0f) + (_ctx.Snow > 0.2f ? 0.25f : 0f) - (_ctx.Rain > 0.5f ? 0.2f : 0f);
            return Mathx.Saturate((1f - (_time - fp.Time) / ageMax) * vis);
        }
        private float CampSig(Ped hunter)
        {
            float best = 0f;
            IReadOnlyList<CampSite> sites = _camp.Sites;
            for (int i = 0; i < sites.Count; i++)
            {
                CampSite site = sites[i];
                if (site == null || !site.Lit) continue;
                float d = hunter.Position.DistanceTo(site.Position);
                Vector3 hit; int ent;
                if (site.SmokeVisible && d < _ctx.Cfg.CampfireSmokeDetectMeters)
                {
                    bool sky = NativeBridge.ClearLos(site.Position + new Vector3(0f, 0f, 1.2f), site.Position + new Vector3(0f, 0f, 18f), 1, 0, out hit, out ent);
                    best = Math.Max(best, (1f - d / _ctx.Cfg.CampfireSmokeDetectMeters) * (sky ? 1f : 0.25f) * 0.65f);
                }
                if (_ctx.Night && d < _ctx.Cfg.CampfireLightDetectMetersNight)
                    if (NativeBridge.ClearLos(hunter.Position + new Vector3(0f, 0f, 0.7f), site.Position + new Vector3(0f, 0f, 0.5f), 1 | 16, hunter.Handle, out hit, out ent))
                        best = Math.Max(best, (1f - d / _ctx.Cfg.CampfireLightDetectMetersNight) * 0.85f);
            }
            return Mathx.Saturate(best);
        }
        private void Apply(Ped ped, Aware a, float see)
        {
            try
            {
                float camp = CampSig(ped);
                if (camp > a.Alert) a.Alert = Mathx.Lerp(a.Alert, camp, 0.35f);
                Function.Call(Hash.SET_PED_SEEING_RANGE, ped.Handle, see > 0.2f ? 8f + see * 40f : 0.01f);
                Function.Call(Hash.SET_PED_HEARING_RANGE, ped.Handle, a.Alert > 0.2f ? 6f + a.Alert * 28f : 0.01f);
                Function.Call(Hash.SET_PED_ID_RANGE, ped.Handle, see > 0.6f ? 12f : 0.01f);
                if (see > 0.2f)
                {
                    Function.Call(Hash.SET_PED_VISUAL_FIELD_MIN_ANGLE, ped.Handle, -55f);
                    Function.Call(Hash.SET_PED_VISUAL_FIELD_MAX_ANGLE, ped.Handle, 55f);
                }
                else
                {
                    Function.Call(Hash.SET_PED_VISUAL_FIELD_MIN_ANGLE, ped.Handle, 0.01f);
                    Function.Call(Hash.SET_PED_VISUAL_FIELD_MAX_ANGLE, ped.Handle, 0.01f);
                }
                Relationship rel = Relationship.Neutral;
                try { rel = ped.GetRelationship(_ctx.Player); } catch { }
                bool hostile = rel == Relationship.Hate || rel == Relationship.Dislike;
                bool combat = false;
                try { combat = Function.Call<bool>(Hash.IS_PED_IN_COMBAT, ped.Handle, _ctx.Player.Handle); } catch { }
                if (combat && see < 0.12f && a.Alert < 0.25f) { Function.Call(Hash.CLEAR_PED_TASKS, ped.Handle, true, true); a.Until = _time + 6f; }
                else if (hostile && see > 0.62f && a.Alert > 0.45f && !combat) Function.Call(Hash.TASK_COMBAT_PED, ped.Handle, _ctx.Player.Handle, 0, 16);
                else if (a.Has && see < 0.15f && a.Alert > 0.3f && _time > a.Until)
                {
                    try { ped.Task.GoTo(a.Last); }
                    catch { Function.Call(Hash.TASK_GO_STRAIGHT_TO_COORD, ped.Handle, a.Last.X, a.Last.Y, a.Last.Z, 1.0f, -1, 0f, 0f); }
                    a.Until = _time + 9f;
                }
                if (!_acc.ContainsKey(ped.Handle))
                {
                    int ac = Function.Call<int>(Hash.GET_PED_ACCURACY, ped.Handle);
                    _acc[ped.Handle] = ac < 5 ? 55 : ac;
                }
                Function.Call(Hash.SET_PED_ACCURACY, ped.Handle, see < 0.3f ? 8 : _acc[ped.Handle]);
            }
            catch (Exception ex) { _ctx.Log.Error("Perception", "Apply", ex); }
        }
    }

