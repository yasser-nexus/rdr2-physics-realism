            {
                Ped[] peds = World.GetNearbyPeds(player, 28f);
                if (peds == null) return false;
                int n = 0;
                foreach (Ped p in peds)
                {
                    if (n++ > 32) break;
                    if (!NativeBridge.PedOk(p) || p.Handle == player.Handle || p.IsPlayer) continue;
                    bool combat = false; try { combat = Function.Call<bool>(Hash.IS_PED_IN_COMBAT, p.Handle, player.Handle); } catch { }
                    if (combat) return true;
                    try { if (p.GetRelationship(player) == Relationship.Hate && player.Position.DistanceTo(p.Position) < 16f) return true; } catch { }
