            if (_ctx.Blocked || _ctx.Ragdoll) { _velInit = false; _acc = 0f; return; }
            dt = Mathx.Clamp(dt, 0f, _ctx.Cfg.PhysicsMaxDt);
            _acc += dt;
            if (_stumbleCd > 0f) _stumbleCd -= dt;
            if (_recoilCd > 0f) _recoilCd -= dt;
            float step = 1f / Math.Max(30f, _ctx.Cfg.PhysicsHz);
            int max = Mathx.ClampI(_ctx.Cfg.PhysicsMaxSubsteps, 1, 12);
            int n = 0;
            while (_acc >= step && n < max) { Substep(step); _acc -= step; n++; }
            if (n == max) _acc = 0f;
            _substeps = n;
            _phys.NotifySurface(_surface);
            ApplyMotorLimits();
            HandleRecoil();
            MaybeStumble(dt);
        }
        private void Substep(float dt)
        {
            Ped ped = _ctx.Player;
            if (!NativeBridge.PedOk(ped)) return;
            CarriedMassKg = LoadoutMass.EstimateKg(ped, _ctx.Cfg.EquipmentMassKgDefault, _ctx.Cfg.WeaponMassScale);
            _mass = Mathx.Clamp(_ctx.Cfg.BodyMassKg + CarriedMassKg, 50f, 140f);
            Vector3 gameVel = NativeBridge.Velocity(ped);
            if (!_velInit) { _simVel = gameVel; _lastVel = gameVel; _velInit = true; }
            else _simVel = _simVel * 0.72f + gameVel * 0.28f;
            _surface = _surf.SamplePlayer(dt);
            float height = _surface.Valid ? (ped.Position.Z - _surface.Point.Z) : 1f;
            _grounded = _surface.Valid && height < 0.55f && !_ctx.Jumping && !_ctx.Swimming;
            if (_grounded) _airTime = 0f; else _airTime += dt;
            if (_ctx.OnFoot) SimulateOnFoot(dt, ped, gameVel);
            else if (_ctx.OnMount) SimulateMounted(dt, ped, gameVel);
            else if (_ctx.Swimming || _ctx.InWater) SimulateWater(dt, ped, gameVel);
            ResolveNearbyPeds();
            _lastVel = _simVel;
        }
        private void SimulateOnFoot(float dt, Ped ped, Vector3 gameVel)
        {
            var cfg = _ctx.Cfg; var st = _phys.State;
            Vector3 force = Vector3.Zero;
            Vector3 wish = WishDirection(ped);
            float wishSpeed = DesiredSpeed(st);
            Vector3 wishVel = wish * wishSpeed;
            Vector3 vel = _simVel;
            Vector3 relAir = vel - _ctx.WindVec * 0.35f;
            float sp = relAir.Length();
            if (sp > 0.05f) { float drag = 0.5f * cfg.AirDensity * cfg.PedCd * cfg.PedDragArea * sp; force += -Mathx.SafeNormalize(relAir) * drag * sp; }
            force += _ctx.WindVec * (cfg.WindAccelScale * _mass * (1f + st.Wetness * 0.25f));
            if (_grounded && _surface.Valid)
            {
                Vector3 nrm = _surface.Normal;
                vel = Mathx.ProjectOnPlane(vel, nrm);
                float muS = Mathx.Clamp(_surface.MuStatic * (1f - st.GripPenalty * 0.45f), 0.05f, 1.4f);
                float muK = Mathx.Clamp(_surface.MuKinetic * (1f - st.GripPenalty * 0.50f), 0.03f, 1.2f);
                float gN = cfg.Gravity * Math.Max(0.15f, nrm.Z);
                Vector3 slopeDown = Mathx.SafeNormalize(Mathx.ProjectOnPlane(new Vector3(0f, 0f, -1f), nrm));
                float slope = _surface.SlopeDeg;
                if (slope >= cfg.SlopeSlideStartDeg)
                {
                    float k = Mathx.Saturate((slope - cfg.SlopeSlideStartDeg) / Math.Max(1f, cfg.SlopeUnwalkableDeg - cfg.SlopeSlideStartDeg));
                    force += slopeDown * (cfg.Gravity * (float)Math.Sin(slope * Mathx.Deg2Rad) * k * (1f - muK * 0.5f)) * _mass;
                    wishVel *= 1f - k * 0.85f;
                }
                Vector3 hWish = Mathx.ProjectOnPlane(wishVel, nrm);
                Vector3 hVel = Mathx.ProjectOnPlane(vel, nrm);
                Vector3 delta = hWish - hVel;
                float dLen = delta.Length();
                float fatigue = 1f - st.MovePenalty;
                float massN = Mathx.Clamp(_mass / 86f, 0.8f, 1.8f);
                float accel = cfg.MaxAccelMps2 * fatigue / massN * (0.55f + muS * 0.45f);
                float decel = cfg.MaxDecelMps2 * (0.40f + muK * 0.60f) / massN;
                if (_surface.Kind == GroundKind.Mud) { accel *= 0.62f; decel *= 1.15f; }
                if (_surface.Kind == GroundKind.Snow) { accel *= 0.70f; decel *= 0.90f; }
                if (_surface.Kind == GroundKind.Ice) { accel *= 0.38f; decel *= 0.28f; }
                if (st.Stamina < 8f) accel *= 0.45f;
                if (st.IsHypothermic) accel *= 0.72f;
                bool braking = hWish.Length() < 0.35f || Mathx.Dot(hWish, hVel) < 0f;
                float maxA = braking ? decel : accel;
                if (dLen > 0.0001f) force += delta * (Math.Min(dLen, maxA * dt) / dLen / dt) * _mass;
                Vector3 slip = braking ? hVel : (hVel - Mathx.SafeNormalize(hWish) * Math.Min(hVel.Length(), wishSpeed));
                Vector3 slipH = Mathx.Horizontal(slip);
                float slipS = slipH.Length();
                if (slipS > 0.03f)
                {
                    float fMax = muK * _mass * gN;
                    force += (-Mathx.SafeNormalize(slipH) * Math.Min(fMax, slipS * _mass / Math.Max(dt, 0.001f))) * cfg.FrictionBlend;
                }
                if (slope >= cfg.SlopeUnwalkableDeg && nrm.Z < 0.62f) force += slopeDown * cfg.Gravity * 0.55f * _mass;
                _simVel = vel;
            }
            else
            {
                Vector3 airDelta = Mathx.Horizontal(wish) * 1.6f - Mathx.Horizontal(vel);
                force += Mathx.ClampLength(airDelta, 3.2f * (1f - st.MovePenalty)) * _mass;
                if (_airTime > 0.35f) force += new Vector3(0f, 0f, -cfg.Gravity * 0.18f) * _mass;
            }
            IntegrateAndCommit(ped, dt, gameVel, force, true);
            IntegrateHeading(ped, dt, st);
        }
        private void SimulateMounted(float dt, Ped ped, Vector3 gameVel)
        {
            float massN = Mathx.Clamp(_mass / 86f, 0.9f, 1.7f);
            Vector3 extra = -Mathx.Horizontal(gameVel) * (0.08f * (massN - 1f) + _phys.State.MovePenalty * 0.12f);
            Vector3 blended = Mathx.ClampLength(gameVel + extra * dt * 8f, 22f);
            _simVel = _simVel * 0.5f + blended * 0.5f;
            NativeBridge.SetVelocity(ped, gameVel + Mathx.ClampLength(_simVel - gameVel, 0.22f));
        }
        private void SimulateWater(float dt, Ped ped, Vector3 gameVel)
        {
            var cfg = _ctx.Cfg;
            Vector3 vel = _simVel * 0.6f + gameVel * 0.4f;
            float waterH; NativeBridge.TryWaterHeight(ped.Position, out waterH);
            float submerged = Mathx.Saturate(Mathx.Clamp(waterH - (ped.Position.Z - 0.9f), 0f, 2.2f) / 1.4f);
            float buoyancy = cfg.WaterDensity * 0.07f * cfg.Gravity * cfg.BuoyancyFactor * submerged;
            Vector3 f = new Vector3(0f, 0f, buoyancy - _mass * cfg.Gravity * 0.15f * submerged);
            float sp = vel.Length();
            if (sp > 0.03f) f += -Mathx.SafeNormalize(vel) * (0.5f * cfg.WaterDensity * 1.2f * 0.45f * sp * sp * 0.0015f);
            vel += Mathx.ClampLength(f * (1f / _mass) * dt, cfg.MaxVelocityDeltaPerStep);
            vel *= (float)Math.Exp(-1.8f * submerged * dt);
            _simVel = vel;
            NativeBridge.SetVelocity(ped, gameVel + Mathx.ClampLength(vel - gameVel, cfg.MaxVelocityDeltaPerStep));
        }
        private void IntegrateAndCommit(Ped ped, float dt, Vector3 gameVel, Vector3 force, bool clampHoriz)
        {
            var cfg = _ctx.Cfg;
            Vector3 a = force * (1f / _mass);
            if (!Mathx.Finite(a)) return;
            a = Mathx.ClampLength(a, 48f);
            Vector3 vel = _simVel + Mathx.ClampLength(a * dt, cfg.MaxVelocityDeltaPerStep);
            if (clampHoriz)
            {
                Vector3 h = Mathx.Horizontal(vel);
                float maxS = cfg.MaxHorizontalSpeed * (1f - _phys.State.MovePenalty * 0.45f);
                if (_surface.Kind == GroundKind.Ice) maxS *= 1.05f;
                if (_surface.Kind == GroundKind.Mud) maxS *= 0.78f;
                if (_surface.Kind == GroundKind.Snow) maxS *= 0.84f;
                h = Mathx.ClampLength(h, maxS);
                vel = new Vector3(h.X, h.Y, vel.Z);
            }
            if (_grounded && _surface.Valid)
            {
                vel = Mathx.ProjectOnPlane(vel, _surface.Normal);
                if (vel.Z > 0.35f) vel.Z *= 0.35f;
            }
            _simVel = vel;
            Vector3 blended = gameVel + Mathx.ClampLength(vel - gameVel, cfg.MaxVelocityDeltaPerStep) * cfg.MaxForceBlend;
            if (_ctx.Climbing) blended = gameVel;
            NativeBridge.SetVelocity(ped, blended);
        }
        private void IntegrateHeading(Ped ped, float dt, PhysiologyState st)
        {
            if (!_headingInit) { _heading = ped.Heading; _headingInit = true; }
            float speed = Mathx.HorizontalLength(_simVel);
            float massN = Mathx.Clamp(_mass / 86f, 0.8f, 1.9f);
            float maxTurn = Mathx.Lerp(280f, 88f, Mathx.Saturate(speed / 7.2f));
            maxTurn /= massN * (1f + st.MovePenalty * 0.65f);
            if (_surface.Kind == GroundKind.Ice) maxTurn *= 0.55f;
            if (_surface.Kind == GroundKind.Mud) maxTurn *= 0.78f;
            if (st.GripPenalty > 0.4f) maxTurn *= 0.85f;
            float diff = Mathx.NormalizeDeg(ped.Heading - _heading);
            float step = maxTurn * dt;
            if (diff > step) diff = step;
            if (diff < -step) diff = -step;
            _heading = Mathx.Normalize360(_heading + diff);
            if (speed > 1.05f && Math.Abs(Mathx.NormalizeDeg(ped.Heading - _heading)) > 0.4f)
            {
                try { Function.Call(Hash.SET_ENTITY_HEADING, ped.Handle, _heading); } catch { }
            }
        }
        private Vector3 WishDirection(Ped ped)
        {
            Vector3 camF = Mathx.SafeNormalize(Mathx.Horizontal(NativeBridge.CameraForward()));
            Vector3 camR = new Vector3(camF.Y, -camF.X, 0f);
            float x = 0f, y = 0f;
            try
            {
                if (Game.IsControlPressed(0, Control.MoveUpOnly)) y += 1f;
                if (Game.IsControlPressed(0, Control.MoveDownOnly)) y -= 1f;
                if (Game.IsControlPressed(0, Control.MoveLeftOnly)) x -= 1f;
                if (Game.IsControlPressed(0, Control.MoveRightOnly)) x += 1f;
            }
            catch { if (_ctx.Sprinting || _ctx.Running || _ctx.Walking) y = 1f; }
            Vector3 w = camF * y + camR * x;
            if (w.Length() < 0.12f) return _ctx.Speed > 0.4f ? Mathx.SafeNormalize(Mathx.Horizontal(NativeBridge.Forward(ped))) : Vector3.Zero;
            return Mathx.SafeNormalize(Mathx.Horizontal(w));
        }
        private float DesiredSpeed(PhysiologyState st)
        {
            float s;
            if (_ctx.Sprinting) s = 7.1f;
            else if (_ctx.Running) s = 5.1f;
            else if (_ctx.Walking) s = 2.15f;
            else if (_ctx.Stealth) s = 1.35f;
            else if (_ctx.Speed > 0.3f) s = Math.Min(_ctx.Speed, 5.1f);
            else s = 0f;
            s *= 1f - st.MovePenalty * 0.55f;
            s *= Mathx.Clamp(86f / Math.Max(60f, _mass), 0.72f, 1.05f);
            return Math.Max(0f, s);
        }
        private void ResolveNearbyPeds()
        {
            if (!_ctx.OnFoot) return;
            Ped self = _ctx.Player;
            Ped[] list;
            try { list = World.GetNearbyPeds(self, _ctx.Cfg.PhysicsNearbyRadius); } catch { return; }
            if (list == null) return;
            int n = 0;
            Vector3 ppos = self.Position;
            float r0 = _ctx.Cfg.CollisionRadius;
            int cap = _ctx.Cfg.PhysicsNearbyPedCap;
            for (int i = 0; i < list.Length && n < cap; i++)
            {
                Ped o = list[i];
                if (!NativeBridge.PedOk(o) || o.Handle == self.Handle) continue;
                if (o.IsInVehicle()) continue;
                try { if (Function.Call<bool>(Hash.IS_PED_ON_MOUNT, o.Handle)) continue; } catch { }
                Vector3 d = Mathx.Horizontal(ppos - o.Position);
                float dist = d.Length();
                float min = r0 + _ctx.Cfg.CollisionRadius * 0.95f;
                if (dist >= min || dist < 0.001f) continue;
                Vector3 nrm = d * (1f / dist);
                Vector3 ov = NativeBridge.Velocity(o);
                Vector3 rel = Mathx.Horizontal(_simVel - ov);
                float relN = Mathx.Dot(rel, nrm);
                float j = 0f;
                if (relN < 0f) j = -(1f + _ctx.Cfg.RestitutionPed) * relN / (1f / _mass + 1f / 72f);
                Vector3 impulse = nrm * j;
                _simVel += impulse * (1f / _mass);
                Vector3 v2 = ov - impulse * (1f / 72f);
                NativeBridge.SetVelocity(self, NativeBridge.Velocity(self) + Mathx.ClampLength(_simVel - NativeBridge.Velocity(self), 0.35f));
                NativeBridge.SetVelocity(o, ov + Mathx.ClampLength(v2 - ov, 0.28f));
                if (-relN > _ctx.Cfg.ImpactStumbleSpeed && _stumbleCd <= 0f) TriggerStumble(self, 120, "ped-impact");
                n++;
            }
        }
        private void HandleRecoil()
        {
            if (!_ctx.Shooting || _recoilCd > 0f || !_ctx.OnFoot) return;
            _recoilCd = 0.09f;
            float impulse = Mathx.Clamp(LoadoutMass.WeaponKg(_ctx.Player) / Math.Max(0.4f, _ctx.Cfg.RecoilMassRefKg), 0.35f, 2.8f);
            impulse *= 1f + _phys.State.GripPenalty * 0.55f + _phys.State.HandTremor * 0.4f;
            Vector3 back = -Mathx.SafeNormalize(Mathx.Horizontal(_ctx.Fwd)) * impulse * 0.55f;
            NativeBridge.SetVelocity(_ctx.Player, NativeBridge.Velocity(_ctx.Player) + Mathx.ClampLength(back, 0.42f));
            try
            {
                Function.Call(Hash.SHAKE_GAMEPLAY_CAM, "SMALL_EXPLOSION_SHAKE", 0.045f * impulse);
                Function.Call(Hash.SET_PAD_SHAKE, 0, 70, (int)Mathx.Clamp(impulse * 48f, 20f, 160f));
            }
            catch { }
        }
        private void MaybeStumble(float dt)
        {
            if (!_ctx.OnFoot || _stumbleCd > 0f) return;
            Vector3 a = (_simVel - _lastVel) / Math.Max(dt, 0.001f);
            float lat = Mathx.HorizontalLength(a);
            bool iceSlip = _surface.Kind == GroundKind.Ice && Mathx.HorizontalLength(_simVel) > 3.2f && lat > 8f;
            bool slopeFall = _surface.Valid && _surface.SlopeDeg > _ctx.Cfg.SlopeUnwalkableDeg && _ctx.Speed > 2.5f;
            bool wetSprint = _surface.Wet && _ctx.Sprinting && lat > _ctx.Cfg.StumbleAccel;
            if (lat > _ctx.Cfg.StumbleAccel * (1.15f - _phys.State.GripPenalty) || iceSlip || slopeFall || wetSprint)
                TriggerStumble(_ctx.Player, 90, "accel");
        }
        private void TriggerStumble(Ped ped, int ms, string why)
        {
            _stumbleCd = 1.15f;
            try { Function.Call(Hash.SET_PED_TO_RAGDOLL, ped.Handle, ms, ms + 80, 0, false, false, false); _ctx.Log.Info("Physics", "Stumble " + why + " v=" + _ctx.Speed.ToString("0.00")); }
            catch { try { Function.Call(Hash.SET_PAD_SHAKE, 0, 180, 180); } catch { } }
            _phys.State.MuscleFatigue = Mathx.Clamp(_phys.State.MuscleFatigue + 4.5f, 0f, 100f);
            _phys.State.Stamina = Mathx.Clamp(_phys.State.Stamina - 6f, 0f, 100f);
        }
        private void ApplyMotorLimits()
        {
            if (!_ctx.Valid || !_ctx.OnFoot) return;
            try
            {
                float rate = Mathx.Clamp(1.02f - (_mass / 86f - 1f) * 0.18f - _phys.State.MovePenalty * 0.5f - _ctx.Snow * 0.15f - (_surface.Kind == GroundKind.Mud ? 0.14f : 0f), 0.2f, 1.05f);
                Function.Call(Hash.SET_PED_MOVE_RATE_OVERRIDE, _ctx.Player.Handle, rate);
                Function.Call(Hash.SET_PED_MAX_MOVE_BLEND_RATIO, _ctx.Player.Handle, rate);
                if (_surface.Valid && _surface.SlopeDeg > _ctx.Cfg.SlopeUnwalkableDeg * 0.85f && _ctx.Sprinting)
                    Function.Call(Hash.SET_PED_DESIRED_MOVE_BLEND_RATIO, _ctx.Player.Handle, 0.4f);
                if (_phys.State.IsExhausted)
                {
                    Function.Call(Hash.DISABLE_CONTROL_ACTION, 0, (int)Control.Sprint, true);
                    uint t = (uint)Environment.TickCount;
                    if (t - _lastJumpDisable > 16) { Function.Call(Hash.DISABLE_CONTROL_ACTION, 0, (int)Control.Jump, true); _lastJumpDisable = t; }
                }
                _ctx.Log.Verbose("Physics", "g=" + _grounded + " " + _surface.Kind + " slp=" + _surface.SlopeDeg.ToString("0.0") + " kg=" + _mass.ToString("0.0") + " n=" + _substeps + " v=" + Mathx.HorizontalLength(_simVel).ToString("0.00"));
            }
            catch (Exception ex) { _ctx.Log.Error("Physics", "MotorLimits", ex); }
        }
    }

    public sealed class CampSite
    {
        public Prop Fire; public Prop Bedroll; public Prop Pot;
        public Vector3 Position; public float Heading; public bool Lit;
        public float Fuel = 100f; public float HeatRadius = 4.5f; public bool SmokeVisible;
    }

    public sealed class CampingEngine
    {
        public const string FireName = "p_campfire02x";
        public const string BedName = "p_bedrollopen01x";
        public const string PotName = "p_cs_pot01x";
        private readonly uint _fireHash, _bedHash, _potHash;
        private readonly GameContext _ctx;
        private readonly PhysiologyEngine _phys;
        private readonly List<CampSite> _sites = new List<CampSite>();
        private readonly KeyEdge _keyG = new KeyEdge();
        private readonly KeyEdge _keyH = new KeyEdge();
        private float _accum; private string _lastDeny = ""; private int _denyCd, _loadFrames; private bool _pendingPlace;
        public IReadOnlyList<CampSite> Sites { get { return _sites; } }
        public CampSite Active { get; private set; }
        public CampingEngine(GameContext ctx, PhysiologyEngine phys)
        {
            _ctx = ctx; _phys = phys;
            _fireHash = (uint)Game.GenerateHash(FireName);
            _bedHash = (uint)Game.GenerateHash(BedName);
            _potHash = (uint)Game.GenerateHash(PotName);
        }
        public void Update(float dt)
        {
            if (!_ctx.Valid) return;
            _accum += dt;
            if (_accum < _ctx.Cfg.TickCamping) return;
            float step = _accum; _accum = 0f;
            if (_denyCd > 0) _denyCd--;
            HandleInput(); PumpPendingPlace(); Maintain(step); Warmth(step);
        }
        private void HandleInput()
        {
            try
            {
                bool aim = Game.IsControlPressed(0, Control.Aim);
                bool context = false; try { context = Game.IsControlJustPressed(0, Control.Context); } catch { }
                if (_keyG.WentDown(Keys.G) || (aim && context)) RequestPlace();
                bool reload = Game.IsControlJustPressed(0, Control.Reload);
                if (_keyH.WentDown(Keys.H) || (aim && reload)) TryPack();
            }
            catch (Exception ex) { _ctx.Log.Error("Camping", "Input", ex); }
        }
        private void RequestPlace()
        {
            string reason; Vector3 pos; float heading; Vector3 normal;
            if (!Evaluate(_ctx.Player, out pos, out heading, out normal, out reason)) { Deny(reason); return; }
            _pendingPlace = true; _loadFrames = 0;
            NativeBridge.RequestModel(_fireHash); NativeBridge.RequestModel(_bedHash); NativeBridge.RequestModel(_potHash);
        }
        private void PumpPendingPlace()
        {
            if (!_pendingPlace) return;
            _loadFrames++;
            NativeBridge.RequestModel(_fireHash); NativeBridge.RequestModel(_bedHash); NativeBridge.RequestModel(_potHash);
            bool ready = NativeBridge.ModelLoaded(_fireHash) && NativeBridge.ModelLoaded(_bedHash) && NativeBridge.ModelLoaded(_potHash);
            if (!ready) { if (_loadFrames > 90) { _pendingPlace = false; Deny("Camp models not ready."); } return; }
            _pendingPlace = false; TrySpawn();
        }
        private void TrySpawn()
        {
            string reason; Vector3 pos; float heading; Vector3 normal;
            if (!Evaluate(_ctx.Player, out pos, out heading, out normal, out reason)) { Deny(reason); ReleaseModels(); return; }
            try
            {
                Vector3 fwd = Mathx.Horizontal(_ctx.Fwd);
                if (fwd.Length() < 0.01f) fwd = new Vector3(0f, 1f, 0f);
                fwd = Mathx.SafeNormalize(fwd);
                int fire = Function.Call<int>(Hash.CREATE_OBJECT, _fireHash, pos.X, pos.Y, pos.Z, true, true, false, false, true);
                if (!NativeBridge.DoesExist(fire)) { Deny("Failed to spawn p_campfire02x."); ReleaseModels(); return; }
                Function.Call(Hash.SET_ENTITY_HEADING, fire, heading);
                Function.Call(Hash.PLACE_ENTITY_ON_GROUND_PROPERLY, fire, true);
                Function.Call(Hash.FREEZE_ENTITY_POSITION, fire, true);
                Vector3 bedPos = pos - fwd * 1.35f; float bz; NativeBridge.TryGroundZ(bedPos + new Vector3(0f, 0f, 2f), out bz); bedPos.Z = bz;
                int bed = Function.Call<int>(Hash.CREATE_OBJECT, _bedHash, bedPos.X, bedPos.Y, bedPos.Z, true, true, false, false, true);
                if (NativeBridge.DoesExist(bed))
                {
                    Function.Call(Hash.SET_ENTITY_HEADING, bed, heading + 90f);
                    Function.Call(Hash.PLACE_ENTITY_ON_GROUND_PROPERLY, bed, true);
                    Function.Call(Hash.FREEZE_ENTITY_POSITION, bed, true);
                }
                Vector3 potPos = pos + fwd * 0.45f + new Vector3(-fwd.Y, fwd.X, 0f) * 0.55f; float pz; NativeBridge.TryGroundZ(potPos + new Vector3(0f, 0f, 2f), out pz); potPos.Z = pz;
                int pot = Function.Call<int>(Hash.CREATE_OBJECT, _potHash, potPos.X, potPos.Y, potPos.Z, true, true, false, false, true);
                if (NativeBridge.DoesExist(pot))
                {
                    Function.Call(Hash.SET_ENTITY_HEADING, pot, heading);
                    Function.Call(Hash.PLACE_ENTITY_ON_GROUND_PROPERLY, pot, true);
                    Function.Call(Hash.FREEZE_ENTITY_POSITION, pot, true);
                }
                var site = new CampSite
                {
                    Fire = new Prop(fire),
                    Bedroll = NativeBridge.DoesExist(bed) ? new Prop(bed) : null,
                    Pot = NativeBridge.DoesExist(pot) ? new Prop(pot) : null,
                    Position = pos, Heading = heading, Lit = true, Fuel = 100f, SmokeVisible = true
                };
                _sites.Add(site); Active = site;
                _ctx.Log.Info("Camping", "Placed " + pos.X.ToString("0.00") + "," + pos.Y.ToString("0.00") + "," + pos.Z.ToString("0.00"));
                ReleaseModels();
            }
            catch (Exception ex) { _ctx.Log.Error("Camping", "TrySpawn", ex); Deny("Camp placement error."); ReleaseModels(); }
        }
        private void ReleaseModels() { NativeBridge.ReleaseModel(_fireHash); NativeBridge.ReleaseModel(_bedHash); NativeBridge.ReleaseModel(_potHash); }
        public void TryPack()
        {
            CampSite n = Nearest(3.4f);
            if (n == null) { Deny("No camp within reach."); return; }
            Delete(n); _sites.Remove(n);
            Active = _sites.Count > 0 ? _sites[_sites.Count - 1] : null;
            _ctx.Log.Info("Camping", "Packed.");
        }
        public bool Evaluate(Ped ped, out Vector3 pos, out float heading, out Vector3 normal, out string reason)
        {
            pos = Vector3.Zero; heading = 0f; normal = new Vector3(0f, 0f, 1f); reason = "Unknown";
            if (!NativeBridge.PedOk(ped)) { reason = "Invalid ped."; return false; }
            if (_ctx.OnMount) { reason = "Dismount first."; return false; }
            if (_ctx.Swimming || _ctx.InWater) { reason = "Cannot camp in water."; return false; }
            if (_ctx.Shooting) { reason = "Cannot camp while firing."; return false; }
            if (_ctx.Speed > 1.15f) { reason = "Stand still."; return false; }
            if (_ctx.Ragdoll) { reason = "Cannot camp while off-balance."; return false; }
            try { if (Function.Call<bool>(Hash.IS_PED_IN_COMBAT, ped.Handle, 0)) { reason = "Cannot camp during combat."; return false; } } catch { }
            if (Hostile(ped)) { reason = "Hostiles too close."; return false; }
            Vector3 fwd = Mathx.Horizontal(NativeBridge.Forward(ped));
            if (fwd.Length() < 0.001f) fwd = new Vector3(0f, 1f, 0f);
            fwd = Mathx.SafeNormalize(fwd);
            Vector3 probe = ped.Position + fwd * _ctx.Cfg.CampPlaceDistance + new Vector3(0f, 0f, 0.4f);
            float gz;
            if (!NativeBridge.TryGroundZ(probe + new Vector3(0f, 0f, 8f), out gz)) { reason = "No solid ground."; return false; }
            pos = new Vector3(probe.X, probe.Y, gz); heading = ped.Heading;
            float wh;
            if (NativeBridge.TryWaterHeight(pos, out wh) && wh >= gz - 0.12f) { reason = "Flooded surface."; return false; }
            float zL, zR, zF, zB;
            NativeBridge.TryGroundZ(pos + new Vector3(-0.7f, 0f, 2f), out zL);
            NativeBridge.TryGroundZ(pos + new Vector3(0.7f, 0f, 2f), out zR);
            NativeBridge.TryGroundZ(pos + new Vector3(0f, 0.7f, 2f), out zF);
            NativeBridge.TryGroundZ(pos + new Vector3(0f, -0.7f, 2f), out zB);
            float slope = (float)Math.Atan(Math.Max(Math.Abs(zL - zR), Math.Abs(zF - zB)) / 1.4f) * Mathx.Rad2Deg;
            if (slope > _ctx.Cfg.CampMaxSlopeDegrees) { reason = "Slope too steep (" + slope.ToString("0.0") + ")."; return false; }
            normal = Mathx.SafeNormalize(new Vector3(zL - zR, zB - zF, 1.4f));
            if (!Clear(pos, _ctx.Cfg.CampMinClearRadius, ped.Handle)) { reason = "Area obstructed."; return false; }
            try { if (Function.Call<int>(Hash.GET_INTERIOR_FROM_ENTITY, ped.Handle) != 0) { reason = "Not a wilderness camp indoors."; return false; } } catch { }
