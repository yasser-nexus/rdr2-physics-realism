                didHit = hitA.GetResult<bool>();
                hit = endA.GetResult<Vector3>();
                normal = nA.GetResult<Vector3>();
                ent = eA.GetResult<int>();
                if (!Mathx.Finite(hit)) hit = to;
                if (!Mathx.Finite(normal) || normal.Length() < 0.001f) normal = new Vector3(0f, 0f, 1f);
