    public sealed class UltimateRealismScript : Script
    {
        private readonly RealismConfig _cfg;
        private readonly RealismLog _log;
        private readonly GameContext _ctx;
        private readonly PhysiologyEngine _physiology;
        private readonly SmartPhysicsEngine _physics;
        private readonly CampingEngine _camping;
        private readonly PerceptionEngine _perception;
        private readonly RealismHud _hud;
        private readonly Stopwatch _clock = Stopwatch.StartNew();
        private long _last;
        private bool _stop;
        private int _failStreak;

        public UltimateRealismScript()
        {
            _cfg = RealismConfig.LoadOrCreate();
            _log = new RealismLog(_cfg.LogFileName, _cfg.VerboseLog);
            _ctx = new GameContext(_cfg, _log);
            _physiology = new PhysiologyEngine(_ctx);
            _physics = new SmartPhysicsEngine(_ctx, _physiology);
            _camping = new CampingEngine(_ctx, _physiology);
            _perception = new PerceptionEngine(_ctx, _camping);
            _hud = new RealismHud(_ctx, _physiology, _physics);
            _last = _clock.ElapsedTicks;
            Tick += OnTick;
            Aborted += OnAborted;
            Interval = 0;
            _log.Info("Boot", "UltimateRealism 2.1 started.");
            _log.Info("Boot", "G camp | H pack | Reload+Duck eat | Reload+Jump drink | FrontendSelect HUD");
        }

        private void OnTick(object sender, EventArgs e)
        {
            if (_stop) return;
            try
            {
                long now = _clock.ElapsedTicks;
                float dt = (now - _last) / (float)Stopwatch.Frequency;
                _last = now;
                dt = Mathx.Clamp(dt, 0f, 0.25f);
                if (Game.Player == null) return;
                _ctx.Refresh(dt);
                if (!_ctx.Valid) return;
                if (_failStreak > 40)
                {
                    _log.Warn("Tick", "Failsafe: physics isolated.");
                    Safe("Physiology", () => _physiology.Update(dt));
                    Safe("Camping", () => _camping.Update(dt));
                    _failStreak = 30;
                    return;
                }
                Safe("Physics", () => _physics.Update(dt));
                Safe("Physiology", () => _physiology.Update(dt));
                Safe("Camping", () => _camping.Update(dt));
                Safe("Perception", () => _perception.Update(dt));
                Safe("HUD", () => _hud.Update(dt));
                if (_failStreak > 0) _failStreak--;
            }
            catch (Exception ex)
            {
                _failStreak += 5;
                _log.Error("Tick", "Unhandled", ex);
            }
        }

        private void Safe(string name, Action fn)
        {
            try { fn(); }
            catch (Exception ex)
            {
                _failStreak += 2;
                _log.Error(name, "tick", ex);
            }
        }

        private void OnAborted(object sender, EventArgs e)
        {
            _stop = true;
            try { _camping.Dispose(); }
            catch (Exception ex) { _log.Error("Boot", "Dispose", ex); }
            _log.Info("Boot", "Clean abort.");
        }
    }

