    public sealed class SurfaceSampler
    {
        private readonly GameContext _ctx;
        private SurfaceHit _cache;
        private Vector3 _cachePos;
        private float _cacheAge = 999f;
        public SurfaceSampler(GameContext ctx) { _ctx = ctx; }
        public SurfaceHit SamplePlayer(float dt)
        {
            _cacheAge += dt;
            if (_cache.Valid && _cacheAge < 0.05f && _ctx.Pos.DistanceTo(_cachePos) < 0.18f) return _cache;
            _cache = SampleAt(_ctx.Pos, _ctx.Player != null ? _ctx.Player.Handle : 0);
            _cachePos = _ctx.Pos;
            _cacheAge = 0f;
            return _cache;
        }
        public SurfaceHit SampleAt(Vector3 pos, int ignore)
        {
            var hit = new SurfaceHit { Valid = false, Point = pos, Normal = new Vector3(0f, 0f, 1f), Kind = GroundKind.Dirt, MuStatic = 0.85f, MuKinetic = 0.70f, Restitution = 0.05f, Softness = 0.15f };
            Vector3 from = pos + new Vector3(0f, 0f, 1.35f);
            Vector3 to = pos + new Vector3(0f, 0f, -2.8f);
            Vector3 hp, n; int ent; bool did;
            if (!NativeBridge.Ray(from, to, 1 | 16 | 256, ignore, out hp, out n, out ent, out did) || !did)
            {
                float gz;
                if (NativeBridge.TryGroundZ(pos, out gz)) { hit.Valid = true; hit.Point = new Vector3(pos.X, pos.Y, gz); Classify(ref hit, pos); }
                return hit;
            }
            hit.Valid = true;
            hit.Point = hp;
            hit.Normal = n.Z < 0.08f ? new Vector3(0f, 0f, 1f) : n;
            hit.SlopeDeg = (float)Math.Acos(Mathx.Clamp(hit.Normal.Z, 0f, 1f)) * Mathx.Rad2Deg;
            Classify(ref hit, pos);
            return hit;
        }
        private void Classify(ref SurfaceHit hit, Vector3 pos)
        {
            float rain = _ctx.Rain, snow = _ctx.Snow, waterH;
            bool water = NativeBridge.TryWaterHeight(pos, out waterH) && waterH >= hit.Point.Z - 0.07f;
            if (water || _ctx.InWater)
            {
                hit.Kind = GroundKind.Water; hit.MuStatic = 0.18f; hit.MuKinetic = 0.12f; hit.Restitution = 0f; hit.Softness = 1f; hit.Wet = true; return;
            }
            if (snow > 0.35f) hit.Kind = _ctx.AmbientC < -2f ? GroundKind.Ice : GroundKind.Snow;
            else if (rain > 0.45f) hit.Kind = GroundKind.Mud;
            else if (hit.SlopeDeg > 28f) hit.Kind = GroundKind.Rock;
            else hit.Kind = GroundKind.Dirt;
            switch (hit.Kind)
            {
                case GroundKind.Ice: hit.MuStatic = 0.12f; hit.MuKinetic = 0.06f; hit.Restitution = 0.02f; hit.Softness = 0.05f; break;
                case GroundKind.Snow: hit.MuStatic = 0.38f; hit.MuKinetic = 0.30f; hit.Restitution = 0.01f; hit.Softness = 0.55f; break;
                case GroundKind.Mud: hit.MuStatic = 0.42f; hit.MuKinetic = 0.28f; hit.Restitution = 0f; hit.Softness = 0.70f; hit.Wet = true; break;
                case GroundKind.Rock: hit.MuStatic = 0.90f; hit.MuKinetic = 0.72f; hit.Restitution = 0.08f; hit.Softness = 0.02f; break;
                case GroundKind.Sand: hit.MuStatic = 0.50f; hit.MuKinetic = 0.40f; hit.Restitution = 0f; hit.Softness = 0.45f; break;
                case GroundKind.Wood: hit.MuStatic = 0.70f; hit.MuKinetic = 0.55f; hit.Restitution = 0.06f; hit.Softness = 0.10f; break;
                default: hit.MuStatic = 0.82f; hit.MuKinetic = 0.66f; hit.Restitution = 0.04f; hit.Softness = 0.18f; break;
            }
            if (rain > 0.12f && hit.Kind != GroundKind.Ice)
            {
                float w = Mathx.Saturate(rain);
                hit.MuStatic *= 1f - 0.35f * w;
                hit.MuKinetic *= 1f - 0.40f * w;
                hit.Wet = true;
            }
        }
    }

    public static class LoadoutMass
    {
        public static float EstimateKg(Ped ped, float pack, float weaponScale)
        {
            float kg = pack;
            try
            {
                OutputArgument weap = new OutputArgument();
                Function.Call<bool>(Hash.GET_CURRENT_PED_WEAPON, ped.Handle, weap, true, 0, true);
                kg += Classify(weap.GetResult<uint>()) * weaponScale;
            }
            catch { kg += 2.2f * weaponScale; }
            return Mathx.Clamp(kg, 4f, 55f);
        }
        public static float WeaponKg(Ped ped)
        {
            try
            {
                OutputArgument weap = new OutputArgument();
                Function.Call<bool>(Hash.GET_CURRENT_PED_WEAPON, ped.Handle, weap, true, 0, true);
                return Classify(weap.GetResult<uint>());
            }
            catch { return 2.4f; }
        }
        private static float Classify(uint hash)
        {
            if (hash == 0) return 0.4f;
            uint m = hash & 0xF;
            if (m < 4) return 1.15f;
            if (m < 9) return 3.4f;
            return 4.9f;
        }
    }

    public sealed class PhysiologyEngine
    {
        private readonly GameContext _ctx;
        private readonly PhysiologyState _s = new PhysiologyState();
        private float _hrVel, _tempVel, _stamVel, _accum, _shakeAmp;
        private int _lastHealth = -1;
        private uint _lastShake;
        public PhysiologyState State { get { return _s; } }
        public SurfaceHit LastSurface;
        public PhysiologyEngine(GameContext ctx) { _ctx = ctx; }
        public void NotifySurface(SurfaceHit s) { LastSurface = s; }
        public void Update(float dt)
        {
            if (!_ctx.Valid) return;
            _accum += dt;
            if (_accum < _ctx.Cfg.TickPhysiology) return;
            float step = _accum; _accum = 0f;
            Simulate(step);
            ApplyEffects();
        }
        private void Simulate(float dt)
        {
            var cfg = _ctx.Cfg;
            Ped ped = _ctx.Player;
            float met = Metabolic();
            float hours = dt / 3600f;
            float hungerMul = 1f + Math.Max(0f, met - 1f) * 0.18f + _s.ColdExposure * 0.35f;
            float thirstMul = 1f + Math.Max(0f, met - 1f) * 0.28f + _s.HeatExposure * 0.85f;
            _s.Hunger = Mathx.Clamp(_s.Hunger - cfg.HungerDrainPerHourRest * hungerMul * hours * cfg.HungerMax / 8f, 0f, cfg.HungerMax);
            _s.Thirst = Mathx.Clamp(_s.Thirst - cfg.ThirstDrainPerHourRest * thirstMul * hours * cfg.ThirstMax / 6f, 0f, cfg.ThirstMax);
            FieldConsume();
            _s.Glycogen = Mathx.Lerp(_s.Glycogen, _s.Hunger / cfg.HungerMax, Mathx.ExpDecay(0.15f, dt));
            _s.Hydration = Mathx.Lerp(_s.Hydration, _s.Thirst / cfg.ThirstMax, Mathx.ExpDecay(0.18f, dt));
            Exposure(dt); CoreTemp(dt, met); Cardio(dt, met); Fatigue(dt, met); StaminaTick(dt, met); Penalties();
            int hp = ped.Health;
            if (_lastHealth >= 0 && hp < _lastHealth)
            {
                float dmg = _lastHealth - hp;
                _s.HeartRate = Mathx.Clamp(_s.HeartRate + dmg * 1.6f, cfg.BasalHeartRate, cfg.MaxHeartRate);
                _s.Lactate = Mathx.Clamp(_s.Lactate + dmg * 0.08f, 0f, 20f);
                _ctx.Log.Info("Physiology", "Damage " + dmg.ToString("0.0") + " HR=" + _s.HeartRate.ToString("0.0"));
            }
            _lastHealth = hp;
            _s.IsHypothermic = _s.CoreTempC <= cfg.HypothermiaCoreC;
            _s.IsHyperthermic = _s.CoreTempC >= cfg.HyperthermiaCoreC;
            _s.IsExhausted = _s.MuscleFatigue > 82f || _s.Stamina < 8f;
            _s.IsStarving = _s.Hunger < 12f;
            _s.IsDehydrated = _s.Thirst < 12f;
            _s.BreathPhase += dt * Mathx.Clamp(_s.HeartRate / 60f, 0.4f, 3.2f);
        }
        private float Metabolic()
        {
            float met = 1.05f;
            if (_ctx.OnMount) met = 1.8f;
            else if (_ctx.Swimming) met = 6.2f;
            else if (_ctx.Climbing) met = 8.0f;
            else if (_ctx.Sprinting) met = 9.4f;
            else if (_ctx.Running) met = 6.8f;
            else if (_ctx.Walking) met = 3.1f;
            else if (_ctx.Stealth) met = 2.4f;
            if (_ctx.Shooting) met += 0.7f;
            if (_ctx.Jumping) met += 1.6f;
            met += _s.TerrainStrain * 2.2f + Math.Min(4f, _ctx.Speed * 0.35f);
            if (LastSurface.Valid) met += LastSurface.Softness * 0.8f + LastSurface.SlopeDeg / 40f;
            return met;
        }
        private void Exposure(float dt)
        {
            int interior = 0;
            try { interior = Function.Call<int>(Hash.GET_INTERIOR_FROM_ENTITY, _ctx.Player.Handle); } catch { }
            float shelter = interior != 0 ? 1f : 0f;
            float wetTarget = shelter > 0.5f ? 0f : Mathx.Saturate(_ctx.Rain * 1.15f + (_ctx.InWater ? 1f : 0f) + _ctx.Snow * 0.35f);
            float wetRate = wetTarget > _s.Wetness ? 0.18f : 0.045f + (_ctx.AmbientC > 20f ? 0.04f : 0f);
            _s.Wetness = Mathx.Lerp(_s.Wetness, wetTarget, Mathx.ExpDecay(wetRate, dt));
            float windN = Mathx.Clamp(_ctx.Wind / 12f, 0f, 1.5f);
            float cold = 0f;
            if (_ctx.AmbientC < 10f) cold = Mathx.Clamp((10f - _ctx.AmbientC) / 22f, 0f, 1.4f);
            cold *= (1f + _s.Wetness * 0.9f + windN * 0.45f) * (1f - shelter * 0.85f);
            if (_ctx.Snow > 0.15f) cold += 0.12f;
            _s.ColdExposure = Mathx.Lerp(_s.ColdExposure, Mathx.Clamp(cold, 0f, 1.5f), Mathx.ExpDecay(0.08f, dt));
            float heat = 0f;
            if (_ctx.AmbientC > 26f) heat = Mathx.Clamp((_ctx.AmbientC - 26f) / 16f, 0f, 1.3f);
            if (!_ctx.Night && shelter < 0.5f) heat += 0.08f * (1f - _ctx.Rain);
            if (_ctx.Sprinting) heat += 0.12f;
            _s.HeatExposure = Mathx.Lerp(_s.HeatExposure, Mathx.Clamp(heat * (1f - _s.Wetness * 0.25f), 0f, 1.4f), Mathx.ExpDecay(0.1f, dt));
            float strain = LastSurface.Valid ? Mathx.Saturate(LastSurface.SlopeDeg / 28f + LastSurface.Softness * 0.25f) : 0f;
            if (_ctx.Snow > 0.2f) strain += 0.18f;
            if (_ctx.Rain > 0.35f) strain += 0.12f;
            _s.TerrainStrain = Mathx.Lerp(_s.TerrainStrain, Mathx.Saturate(strain), 0.25f);
        }
        private void CoreTemp(float dt, float met)
        {
            float target = Mathx.Clamp(_ctx.Cfg.RestingCoreTempC + (met - 1f) * 0.045f - _s.ColdExposure * 0.19f + _s.HeatExposure * 0.15f - (1f - _s.Hydration) * 0.25f, 32.5f, 41.2f);
            _s.CoreTempC = Mathx.SmoothDamp(_s.CoreTempC, target, ref _tempVel, _s.ColdExposure > 0.6f ? 18f : 28f, 0.08f, dt);
        }
        private void Cardio(float dt, float met)
        {
            var cfg = _ctx.Cfg;
            float hr = cfg.BasalHeartRate + (met - 1f) * 12.5f + (1f - _s.Hydration) * 18f + _s.Lactate * 3.2f + Math.Abs(_s.CoreTempC - cfg.RestingCoreTempC) * 7.5f + _s.MuscleFatigue * 0.22f;
            if (_ctx.Shooting) hr += 14f;
            hr = Mathx.Clamp(hr, cfg.BasalHeartRate - 4f, cfg.MaxHeartRate);
            _s.HeartRate = Mathx.SmoothDamp(_s.HeartRate, hr, ref _hrVel, _ctx.Sprinting ? 2.2f : 4.8f, 40f, dt);
            float spo2 = 98.5f - Math.Max(0f, _s.HeartRate - 140f) * 0.06f - _s.Lactate * 0.35f - (_ctx.Swimming ? 1.2f : 0f);
            _s.BloodOxygen = Mathx.Clamp(Mathx.Lerp(_s.BloodOxygen, spo2, 0.15f), 82f, 99.5f);
        }
        private void Fatigue(float dt, float met)
        {
            float work = Math.Max(0f, met - 2.2f);
            float gain = work * 1.65f * (1f + _s.TerrainStrain) * (1.15f - 0.15f * _s.Glycogen);
            float rec = 2.8f * _s.Hydration * ((_ctx.Walking || (!_ctx.Running && !_ctx.Sprinting)) ? 1f : 0.15f);
            if (_ctx.Speed < 0.4f) rec *= 1.8f;
            _s.MuscleFatigue = Mathx.Clamp(_s.MuscleFatigue + (gain - rec) * dt, 0f, 100f);
            float lacClear = 0.18f + (_s.HeartRate > 100f ? 0.06f : 0.12f);
            _s.Lactate = Mathx.Clamp(_s.Lactate + (work * 0.22f - lacClear * _s.Lactate) * dt, 0f, 18f);
        }
        private void StaminaTick(float dt, float met)
        {
            float drain = Math.Max(0f, met - 2.0f) * 6.4f * (1f + (1f - _s.Hydration) * 0.5f + _s.MuscleFatigue * 0.006f);
            float regen = 7.5f * _s.Hydration * (1f - _s.HeatExposure * 0.35f);
            if (_ctx.Sprinting) regen = 0f; else if (_ctx.Running) regen *= 0.15f; else if (_ctx.Walking) regen *= 0.55f;
            float target = Mathx.Clamp(_s.Stamina - drain * dt + regen * dt, 0f, _ctx.Cfg.StaminaMax);
            _s.Stamina = Mathx.SmoothDamp(_s.Stamina, target, ref _stamVel, 0.35f, 80f, dt);
        }
        private void Penalties()
        {
            float hrN = Mathx.Saturate((_s.HeartRate - 90f) / 90f);
            float fatN = _s.MuscleFatigue / 100f;
            float tempOff = Math.Abs(_s.CoreTempC - 37f);
            _s.HandTremor = Mathx.Saturate(hrN * 0.45f + fatN * 0.25f + (_s.IsHypothermic ? 0.35f : 0f) + (1f - _s.BloodOxygen / 98f) * 1.2f + (1f - _s.Glycogen) * 0.12f);
            _s.AimPenalty = Mathx.Saturate(_s.HandTremor * 0.85f + _s.Lactate * 0.02f + _s.Wetness * 0.08f);
            _s.ReactionPenalty = Mathx.Saturate(fatN * 0.4f + (1f - _s.Stamina / 100f) * 0.35f + tempOff * 0.08f + (_s.Thirst < 20f ? 0.2f : 0f));
            _s.MovePenalty = Mathx.Clamp(fatN * 0.5f + _s.TerrainStrain * 0.35f + _s.ColdExposure * 0.2f + _s.HeatExposure * 0.15f + (1f - _s.Stamina / 100f) * 0.4f, 0f, 0.92f);
            _s.GripPenalty = Mathx.Saturate(_s.Wetness * 0.45f + _s.ColdExposure * 0.35f + _s.HandTremor * 0.25f + (LastSurface.Wet ? 0.15f : 0f));
        }
        private void FieldConsume()
        {
            try
            {
                bool reload = Game.IsControlPressed(0, Control.Reload);
                if (reload && Game.IsControlJustPressed(0, Control.Duck))
                {
                    _s.Hunger = Mathx.Clamp(_s.Hunger + 28f, 0f, _ctx.Cfg.HungerMax);
                    _s.Glycogen = Mathx.Saturate(_s.Glycogen + 0.22f);
                    _ctx.Log.Info("Physiology", "Ration Hunger=" + _s.Hunger.ToString("0.0"));
                }
                if (reload && Game.IsControlJustPressed(0, Control.Jump))
                {
                    _s.Thirst = Mathx.Clamp(_s.Thirst + 34f, 0f, _ctx.Cfg.ThirstMax);
                    _s.Hydration = Mathx.Saturate(_s.Hydration + 0.25f);
                    _s.CoreTempC -= _s.HeatExposure * 0.08f;
                    _ctx.Log.Info("Physiology", "Water Thirst=" + _s.Thirst.ToString("0.0"));
                }
            }
            catch { }
        }
        private void ApplyEffects()
        {
            Ped ped = _ctx.Player;
            try
            {
                if (_s.BaseAccuracy < 0)
                {
                    _s.BaseAccuracy = Function.Call<int>(Hash.GET_PED_ACCURACY, ped.Handle);
                    if (_s.BaseAccuracy < 5) _s.BaseAccuracy = 70;
                }
                int acc = (int)Mathx.Clamp(_s.BaseAccuracy * (1f - _s.AimPenalty * 0.85f) - _s.HandTremor * 25f, 5f, 100f);
                Function.Call(Hash.SET_PED_ACCURACY, ped.Handle, acc);
                float blend = Mathx.Clamp(1f - _s.MovePenalty, 0.18f, 1f);
                Function.Call(Hash.SET_PED_MAX_MOVE_BLEND_RATIO, ped.Handle, blend);
                Function.Call(Hash.SET_PED_MOVE_RATE_OVERRIDE, ped.Handle, blend);
                _shakeAmp = Mathx.Lerp(_shakeAmp, _s.HandTremor * 0.55f + (_s.HeartRate > 150f ? 0.12f : 0f), 0.2f);
                uint now = (uint)Environment.TickCount;
                if (_s.HandTremor > 0.15f && _ctx.Aiming && now - _lastShake > 180)
                {
                    Function.Call(Hash.SHAKE_GAMEPLAY_CAM, "SMALL_EXPLOSION_SHAKE", _shakeAmp * 0.28f);
                    Function.Call(Hash.SET_PAD_SHAKE, 0, 80, (int)(_s.HandTremor * 110f));
                    _lastShake = now;
                }
                if (_s.IsHypothermic && (Environment.TickCount / 400) % 2 == 0) Function.Call(Hash.SET_PAD_SHAKE, 0, 40, 40);
                if (_s.Stamina <= 0.5f && (_ctx.Sprinting || _ctx.Running)) Function.Call(Hash.SET_PED_DESIRED_MOVE_BLEND_RATIO, ped.Handle, 0.35f);
                _ctx.Log.Verbose("Physiology", "HR=" + _s.HeartRate.ToString("0.0") + " T=" + _s.CoreTempC.ToString("0.00") + " Fat=" + _s.MuscleFatigue.ToString("0.0") + " Stam=" + _s.Stamina.ToString("0.0") + " Acc=" + acc);
            }
            catch (Exception ex) { _ctx.Log.Error("Physiology", "ApplyEffects", ex); }
        }
    }

    public sealed class SmartPhysicsEngine
    {
        private readonly GameContext _ctx;
        private readonly PhysiologyEngine _phys;
        private readonly SurfaceSampler _surf;
        private Vector3 _simVel, _lastVel;
        private float _mass = 86f, _acc, _heading, _airTime, _stumbleCd, _recoilCd;
        private bool _headingInit, _velInit, _grounded;
        private int _substeps;
        private uint _lastJumpDisable;
