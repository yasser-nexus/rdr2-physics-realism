    public static class Mathx
    {
        public const float Deg2Rad = 0.01745329251f;
        public const float Rad2Deg = 57.2957795131f;
        public const float Eps = 1e-5f;
        public static float Clamp(float v, float a, float b) { if (v < a) return a; if (v > b) return b; return v; }
        public static int ClampI(int v, int a, int b) { if (v < a) return a; if (v > b) return b; return v; }
        public static float Lerp(float a, float b, float t) => a + (b - a) * Clamp(t, 0f, 1f);
        public static float Saturate(float v) => Clamp(v, 0f, 1f);
        public static float ExpDecay(float rate, float dt) => 1f - (float)Math.Exp(-Math.Max(0f, rate) * dt);
        public static float SmoothDamp(float current, float target, ref float vel, float smooth, float maxSpeed, float dt)
        {
            smooth = Math.Max(0.0001f, smooth);
            float omega = 2f / smooth;
            float x = omega * dt;
            float exp = 1f / (1f + x + 0.48f * x * x + 0.235f * x * x * x);
            float change = current - target;
            float maxChange = maxSpeed * smooth;
            change = Clamp(change, -maxChange, maxChange);
            float temp = (vel + omega * change) * dt;
            vel = (vel - omega * temp) * exp;
            float output = target + (change + temp) * exp;
            if ((target - current > 0f) == (output > target)) { output = target; vel = 0f; }
            return output;
        }
        public static bool Finite(Vector3 v)
        {
            return !(float.IsNaN(v.X) || float.IsNaN(v.Y) || float.IsNaN(v.Z) || float.IsInfinity(v.X) || float.IsInfinity(v.Y) || float.IsInfinity(v.Z));
        }
        public static Vector3 ClampLength(Vector3 v, float max)
        {
            float l = v.Length();
            if (l > max && l > Eps) return v * (max / l);
            return v;
        }
        public static Vector3 Horizontal(Vector3 v) => new Vector3(v.X, v.Y, 0f);
        public static float HorizontalLength(Vector3 v) => (float)Math.Sqrt(v.X * v.X + v.Y * v.Y);
        public static Vector3 SafeNormalize(Vector3 v)
        {
            float l = v.Length();
            if (l < Eps) return Vector3.Zero;
            return v * (1f / l);
        }
        public static float Dot(Vector3 a, Vector3 b) => a.X * b.X + a.Y * b.Y + a.Z * b.Z;
        public static Vector3 ProjectOnPlane(Vector3 v, Vector3 n)
        {
            n = SafeNormalize(n);
            return v - n * Dot(v, n);
        }
        public static float NormalizeDeg(float a) { while (a > 180f) a -= 360f; while (a < -180f) a += 360f; return a; }
        public static float Normalize360(float a) { while (a < 0f) a += 360f; while (a >= 360f) a -= 360f; return a; }
        public static Vector3 HeadingToForward(float headingDeg)
        {
            float r = headingDeg * Deg2Rad;
            return new Vector3(-(float)Math.Sin(r), (float)Math.Cos(r), 0f);
        }
    }

    public sealed class RealismLog
    {
        private readonly object _gate = new object();
        private readonly string _path;
        private readonly bool _verbose;
        private long _seq;
        public RealismLog(string fileName, bool verbose)
        {
            _verbose = verbose;
            string dir = Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location) ?? ".";
            _path = Path.Combine(dir, string.IsNullOrWhiteSpace(fileName) ? "UltimateRealism.log" : fileName);
            try
            {
                File.AppendAllText(_path, Environment.NewLine + "==== UltimateRealism " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff") + " ====" + Environment.NewLine, Encoding.UTF8);
            }
            catch { }
        }
        public void Info(string sys, string msg) => Write("INFO", sys, msg);
        public void Warn(string sys, string msg) => Write("WARN", sys, msg);
        public void Verbose(string sys, string msg) { if (_verbose) Write("VERB", sys, msg); }
        public void Error(string sys, string msg, Exception ex = null)
        {
            string extra = ex == null ? "" : " | " + ex.GetType().FullName + ": " + ex.Message + Environment.NewLine + ex.StackTrace;
            Write("ERROR", sys, msg + extra);
        }
        private void Write(string level, string sys, string message)
        {
            try
            {
                long n = Interlocked.Increment(ref _seq);
                string line = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff") + " [" + level + "] [" + sys + "] #" + n + " " + message + Environment.NewLine;
                lock (_gate) File.AppendAllText(_path, line, Encoding.UTF8);
            }
            catch { }
        }
    }

