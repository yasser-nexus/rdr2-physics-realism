        private void Maintain(float dt)
        {
            for (int i = _sites.Count - 1; i >= 0; i--)
            {
                CampSite s = _sites[i];
                if (s.Fire == null || !s.Fire.Exists()) { Delete(s); _sites.RemoveAt(i); continue; }
                if (!s.Lit) continue;
                s.Fuel = Mathx.Clamp(s.Fuel - (0.55f + _ctx.Rain * 1.8f + _ctx.Wind * 0.04f) * dt, 0f, 100f);
                if (s.Fuel <= 0f) { s.Lit = false; s.SmokeVisible = false; _ctx.Log.Info("Camping", "Fire out."); }
                else
                {
                    s.SmokeVisible = s.Fuel > 8f;
                    try { Function.Call(Hash.DRAW_LIGHT_WITH_RANGE, s.Position.X, s.Position.Y, s.Position.Z + 0.35f, 255, 140, 40, 8.0f, 18.0f * (s.Fuel / 100f)); } catch { }
